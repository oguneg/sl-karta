# Copy to server/.env and fill in. Never commit .env.
API_PORT=8787

# Trafiklab keys (https://developer.trafiklab.se). Leave empty to run with the built-in demo network.
# Key for "GTFS Regional Static data" (timetables, stops, lines):
TRAFIKLAB_STATIC_KEY=
# Key for "GTFS Regional Realtime" (vehicle positions + delays):
TRAFIKLAB_REALTIME_KEY=

# Monthly call budget for the realtime key. Bronze = 30000, Silver = 2000000.
# The poll interval is derived from this so you never exceed the quota.
RT_MONTHLY_BUDGET=30000
# Never poll faster than this (seconds).
RT_MIN_POLL_SECONDS=3
# Stop polling realtime when no client has asked for data in this many seconds.
RT_IDLE_SECONDS=120

# Force the demo network even if keys are set.
DEMO=false
